DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5433/interview
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/interview
REDIS_URL=redis://localhost:6380
APP_URL=http://localhost:3001
DATA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PRICE_INPUT_USD_PER_1M=0.25
OPENAI_PRICE_OUTPUT_USD_PER_1M=2.00
USD_INR=88

# Sending (src/lib/messaging.ts). Leave unset to keep messages queued (recruiters share links themselves).
# "dev" = nothing leaves this computer; open http://localhost:3001/dev/mailbox to read what was sent.
EMAIL_DRIVER=dev
SMS_DRIVER=dev
# EMAIL_DRIVER=ses  EMAIL_FROM="Interviews <no-reply@your-domain>"
# SMS_DRIVER=gupshup  GUPSHUP_USER= GUPSHUP_PASSWORD= GUPSHUP_SENDER_ID= GUPSHUP_DLT_ENTITY_ID=
#   GUPSHUP_DLT_TEMPLATES=invite=<DLT template id>,deletion_notice=<DLT template id>

# Online billing (src/lib/billing). Unset = staff assign plans. "fake" = a test checkout at /dev/razorpay, no account needed.
BILLING_DRIVER=fake
# BILLING_DRIVER=razorpay  RAZORPAY_KEY_ID=rzp_test_…  RAZORPAY_KEY_SECRET=…  RAZORPAY_WEBHOOK_SECRET=…

# Monitoring: send as "Authorization: Bearer <token>" to /api/health for the detailed report
HEALTH_TOKEN=generate-with-openssl-rand-hex-32

# One-click sign-in buttons for the DEV_* accounts on /login, skipping 2-step login. This computer only:
# the server refuses to start with it set on AWS.
# DEMO_LOGINS=on
